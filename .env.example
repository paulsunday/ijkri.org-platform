# ==============================================================================
# Journal Platform environment variables
#
# Copy this file to .env (or .env.local) and fill in real values.
# Never commit real secrets.
# ==============================================================================

# --- Core -------------------------------------------------------------------
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=https://ijkri.org
# One of these is used as a fallback application base URL by
# server actions that build absolute links (payment callbacks,
# password reset links, invite emails, etc).
NEXT_PUBLIC_APP_URL=
APP_URL=
NEXTAUTH_URL=

# --- Auth ---------------------------------------------------------------
AUTH_SECRET=
BETTER_AUTH_SECRET=

# --- File storage (Vercel Blob) ----------------------------------------
BLOB_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Payments (Paystack) --------------------------------------------------
PAYSTACK_SECRET_KEY=

# --- Rate limiting (Upstash Redis) ----------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron -------------------------------------------------------------------
CRON_SECRET=

# --- Crossref DOI deposit ---------------------------------------------------
# Defaults to https://test.crossref.org/servlet/deposit when unset.
# Swap to https://doi.crossref.org/servlet/deposit for production once
# CROSSREF_DEPOSITOR_LOGIN/PASSWORD are real Crossref depositor credentials.
CROSSREF_DEPOSIT_ENDPOINT=https://test.crossref.org/servlet/deposit
CROSSREF_DEPOSITOR_LOGIN=
CROSSREF_DEPOSITOR_PASSWORD=
CROSSREF_DEPOSITOR_NAME=
CROSSREF_DEPOSITOR_EMAIL=
# The registrant name Crossref shows against this DOI prefix.
CROSSREF_REGISTRANT=

# --- ORCID OAuth ("Connect ORCID") ------------------------------------------
# Defaults to production ORCID (https://orcid.org) when unset.
# ORCID_CLIENT_ID/SECRET must be production credentials registered at
# https://orcid.org/developer-tools (sandbox credentials will not work here).
# Set ORCID_API_BASE=https://sandbox.orcid.org only in non-production
# environments that intentionally test against ORCID's sandbox.
ORCID_API_BASE=https://orcid.org
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# --- OAI-PMH ------------------------------------------------------------
# Fallback admin contact advertised by the OAI-PMH Identify verb when no
# active journal has a contactEmail configured.
OAI_ADMIN_EMAIL=

# --- Monitoring (Sentry) -----------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- AI Article Formatting (Anthropic Claude) --------------------------
# Required by the "Format Article" editorial tool
# (app/editor/submissions/[id]/format-article) to arrange manuscript
# content into the journal's fixed publication template.
ANTHROPIC_API_KEY=
