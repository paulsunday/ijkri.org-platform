generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  domain    String?
  logo      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  journals  Journal[]

  @@index([slug])
}

model Publisher {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  address   String?
  website   String?
  email     String?
  phone     String?
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  journals  Journal[]

  @@index([slug])
}

model Invoice {
  id            String        @id @default(cuid())
  journalId     String
  submissionId  String        @unique
  userId        String
  invoiceNumber String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  currency      Currency      @default(USD)
  status        InvoiceStatus @default(PENDING)
  dueAt         DateTime?
  paidAt        DateTime?
  waivedAt      DateTime?
  waivedAmount  Decimal?      @db.Decimal(10, 2)
  waivedReason  String?
  waivedById    String?
  voidedAt      DateTime?
  waivedBy      User?         @relation("InvoiceWaiverApprover", fields: [waivedById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  journal    Journal    @relation(fields: [journalId], references: [id], onDelete: Restrict)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments   Payment[]

  @@index([journalId])
  @@index([userId])
  @@index([status])
  @@index([dueAt])
  @@index([waivedById])
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String
  processedById     String?
  amount            Decimal      @db.Decimal(10, 2)
  currency          Currency     @default(USD)
  status            RefundStatus @default(PENDING)
  internalReference String       @unique
  providerReference String?      @unique
  reason            String
  providerResponse  Json?
  failureReason     String?
  requestedAt       DateTime     @default(now())
  processedAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  processedBy User?   @relation("RefundProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([processedById])
  @@index([status])
  @@index([requestedAt])
}

model Payment {
  id                String          @id @default(cuid())
  journalId         String
  userId            String
  invoiceId         String?
  subscriptionId    String?
  articlePurchaseId String?
  providerStatus    String?
  providerChannel   String?
  providerFees      Decimal?        @db.Decimal(10, 2)
  paidAmount        Decimal?        @db.Decimal(10, 2)
  customerEmail     String?
  verifiedAt        DateTime?
  purpose           PaymentPurpose
  provider          PaymentProvider @default(PAYSTACK)
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(10, 2)
  currency          Currency        @default(USD)
  internalReference String          @unique
  providerReference String?         @unique
  receiptNumber     String?         @unique
  authorizationUrl  String?
  providerResponse  Json?
  failureReason     String?
  initiatedAt       DateTime        @default(now())
  paidAt            DateTime?
  failedAt          DateTime?
  cancelledAt       DateTime?
  refundedAt        DateTime?
  refundedAmount    Decimal?        @db.Decimal(10, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  journal         Journal             @relation(fields: [journalId], references: [id], onDelete: Restrict)
  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  invoice         Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  subscription    Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  articlePurchase ArticlePurchase?    @relation(fields: [articlePurchaseId], references: [id], onDelete: SetNull)
  refunds         Refund[]
  webhookLogs     PaymentWebhookLog[]

  @@index([journalId])
  @@index([userId])
  @@index([invoiceId])
  @@index([subscriptionId])
  @@index([articlePurchaseId])
  @@index([purpose])
  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id          String             @id @default(cuid())
  journalId   String
  userId      String
  status      SubscriptionStatus @default(PENDING)
  amount      Decimal            @db.Decimal(10, 2)
  currency    Currency           @default(USD)
  startsAt    DateTime?
  expiresAt   DateTime?
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  journal        Journal   @relation(fields: [journalId], references: [id], onDelete: Restrict)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments       Payment[]
  durationMonths Int       @default(1)
  planName       String    @default("Reader Subscription")

  @@index([journalId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model ArticlePurchase {
  id              String    @id @default(cuid())
  journalId       String
  articleId       String
  userId          String
  amount          Decimal   @db.Decimal(10, 2)
  currency        Currency  @default(USD)
  accessGrantedAt DateTime?
  accessRevokedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  journal  Journal   @relation(fields: [journalId], references: [id], onDelete: Restrict)
  article  Article   @relation(fields: [articleId], references: [id], onDelete: Restrict)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([userId, articleId])
  @@index([journalId])
  @@index([articleId])
  @@index([userId])
  @@index([accessGrantedAt])
}

model PaymentWebhookLog {
  id                 String          @id @default(cuid())
  paymentId          String?
  provider           PaymentProvider @default(PAYSTACK)
  providerEventId    String?         @unique
  eventType          String
  signatureValid     Boolean         @default(false)
  processed          Boolean         @default(false)
  processingAttempts Int             @default(0)
  payload            Json
  errorMessage       String?
  receivedAt         DateTime        @default(now())
  lastAttemptAt      DateTime?
  processedAt        DateTime?

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  withdrawalRequestId String?
  withdrawalRequest   WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([eventType])
  @@index([processed])
  @@index([receivedAt])
  @@index([withdrawalRequestId])
}

model User {
  id                         String              @id @default(cuid())
  name                       String
  email                      String              @unique
  passwordHash               String?
  image                      String?
  orcid                      String?
  orcidVerifiedAt            DateTime?
  bio                        String?
  affiliation                String?
  country                    String?
  phone                      String?
  lastLogin                  DateTime?
  isActive                   Boolean             @default(true)
  receivesActionAlerts       Boolean             @default(false)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  emailVerified              DateTime?
  failedLoginAttempts        Int                 @default(0)
  lockedUntil                DateTime?
  passwordChangedAt          DateTime?
  reviewedCareerApplications CareerApplication[] @relation("CareerApplicationReviewer")
  careerApplications         CareerApplication[] @relation("CareerApplicationApplicant")
  decisions                  EditorialDecision[]
  notifications              Notification[]
  invoices                   Invoice[]
  payments                   Payment[]
  subscriptions              Subscription[]
  articlePurchases           ArticlePurchase[]

  passwordResetTokens          PasswordResetToken[]
  createdProductionTasks       ProductionAssignment[] @relation("ProductionAssignedBy")
  assignedProductionTasks      ProductionAssignment[] @relation("ProductionAssignee")
  uploadedProductionFiles      ProductionFile[]       @relation("ProductionFileUploader")
  productionNotes              ProductionNote[]       @relation("ProductionNoteAuthor")
  reviews                      ReviewAssignment[]
  reviewedReviewerApplications ReviewerApplication[]  @relation("ReviewerApplicationReviewer")
  reviewerApplications         ReviewerApplication[]  @relation("ReviewerApplicationApplicant")
  submissions                  Submission[]           @relation("AuthorSubmissions")
  uploadedSubmissionVersions   SubmissionVersion[]    @relation("SubmissionVersionUploader")
  roles                        UserJournalRole[]
  processedRefunds             Refund[]               @relation("RefundProcessor")
  approvedInvoiceWaivers       Invoice[]              @relation("InvoiceWaiverApprover")

  referredByReviewerId String?
  referredByCode       String?
  referredAt           DateTime?

  ambassadorProfile            ReviewerAmbassador?       @relation("AmbassadorUser")
  referredByReviewer           User?                     @relation("UserReferredBy", fields: [referredByReviewerId], references: [id], onDelete: SetNull)
  referredUsers                User[]                    @relation("UserReferredBy")
  referredSubmissions          Submission[]              @relation("SubmissionReferrer")
  suspendedAmbassadors         ReviewerAmbassador[]      @relation("AmbassadorSuspendedBy")
  walletTransactionsMade       WalletTransaction[]       @relation("WalletTransactionCreatedBy")
  rewardSettingsUpdated        AmbassadorRewardSetting[] @relation("RewardSettingUpdatedBy")
  withdrawalsReviewed          WithdrawalRequest[]       @relation("WithdrawalReviewedBy")
  referralEventsAsReviewer     ReferralEvent[]           @relation("ReferralEventReviewer")
  referralEventsAsReferredUser ReferralEvent[]           @relation("ReferralEventReferredUser")

  conflictsAsReviewer ConflictOfInterestCheck[] @relation("ConflictReviewer")
  conflictsOverridden ConflictOfInterestCheck[] @relation("ConflictOverriddenBy")
  reviewRatingsGiven  ReviewAssignment[]        @relation("ReviewAssignmentRatedBy")
  orcidProfile        OrcidProfileSnapshot?

  scoringSettingsUpdated    ReviewerScoringSettings[] @relation("ScoringSettingsUpdatedBy")
  marketingTemplatesCreated MarketingTemplate[]       @relation("MarketingTemplateCreatedBy")
  campaignsCreated          ReferralCampaign[]        @relation("ReferralCampaignCreatedBy")

  agreementSignatures AgreementSignature[]

  @@index([email])
  @@index([referredByReviewerId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Journal {
  id                   String                 @id @default(cuid())
  tenantId             String
  publisherId          String?
  name                 String
  shortName            String
  slug                 String                 @unique
  issnPrint            String?
  issnOnline           String?
  description          String?
  aimsScope            String?
  authorGuidelines     String?
  ethicsPolicy         String?
  peerReviewPolicy     String?
  openAccessPolicy     String?
  apcInfo              String?
  contactEmail         String?
  websiteUrl           String?
  logo                 String?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  articles             Article[]
  invoices             Invoice[]
  payments             Payment[]
  subscriptions        Subscription[]
  articlePurchases     ArticlePurchase[]
  careerApplications   CareerApplication[]
  categories           Category[]
  editorialBoards      EditorialBoardMember[]
  issues               Issue[]
  publisher            Publisher?             @relation(fields: [publisherId], references: [id])
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settings             JournalSettings?
  reviewerApplications ReviewerApplication[]
  submissions          Submission[]
  roles                UserJournalRole[]
  volumes              Volume[]

  apcAmount          Decimal  @default(97.00) @db.Decimal(10, 2)
  subscriptionAmount Decimal  @default(6.00) @db.Decimal(10, 2)
  articlePrice       Decimal  @default(2.00) @db.Decimal(10, 2)
  currency           Currency @default(USD)

  ambassadors   ReviewerAmbassador[]
  rewardSetting AmbassadorRewardSetting?

  marketingTemplates MarketingTemplate[]
  referralCampaigns  ReferralCampaign[]
  scoringSettings    ReviewerScoringSettings?

  resourceGuides        ResourceGuide[]
  insights              Insight[]
  newsletterSubscribers NewsletterSubscriber[]
  events                Event[]

  manuscriptSequences ManuscriptSequence[]

  @@index([slug])
  @@index([tenantId])
  @@index([publisherId])
}

model JournalSettings {
  id                  String   @id @default(cuid())
  journalId           String   @unique
  submissionOpen      Boolean  @default(true)
  reviewType          String   @default("DOUBLE_BLIND")
  plagiarismThreshold Int?
  defaultLanguage     String   @default("English")
  theme               String?
  homepageBanner      String?
  contactAddress      String?
  copyrightPolicy     String?
  license             String?
  footerText          String?
  cfpEnabled          Boolean  @default(false)
  cfpTitle            String?
  cfpMessage          String?
  cfpButtonText       String?
  cfpButtonUrl        String?
  cfpDeadline         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  journal             Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  /*
   * Who must sign the publication agreement, and which license this
   * journal offers by default. Snapshotted onto each
   * PublicationAgreement at send time, so changing this later never
   * retroactively alters an agreement already in flight.
   */
  agreementSignatureMode AgreementSignatureMode @default(CORRESPONDING_AUTHOR_ONLY)
  defaultLicenseType     LicenseType            @default(CC_BY_4)
}

enum ResourceCategory {
  RESEARCH_METHODOLOGY
  DATA_ANALYSIS
  ACADEMIC_WRITING
  PUBLISHING
}

enum ResourceFormat {
  ARTICLE
  GUIDE
  TEMPLATE
  VIDEO
}

model ResourceGuide {
  id          String            @id @default(cuid())
  journalId   String
  category    ResourceCategory
  format      ResourceFormat    @default(GUIDE)
  title       String
  slug        String
  summary     String
  body        String?
  externalUrl String?
  isPublished Boolean           @default(false)
  publishedAt DateTime?
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  journal     Journal           @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, slug])
  @@index([journalId])
  @@index([category])
}

enum InsightCategory {
  RESEARCH_METHODS
  ACADEMIC_WRITING
  STATISTICS
  PUBLISHING
  RESEARCH_ETHICS
  INNOVATION
  MANAGEMENT
  BUSINESS
  TECHNOLOGY
}

model Insight {
  id          String           @id @default(cuid())
  journalId   String
  category    InsightCategory
  title       String
  slug        String
  excerpt     String
  body        String
  authorName  String?
  coverImage  String?
  isPublished Boolean          @default(false)
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  journal     Journal          @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, slug])
  @@index([journalId])
  @@index([category])
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  journalId        String
  email            String
  unsubscribeToken String    @unique @default(cuid())
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?
  journal          Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, email])
  @@index([journalId])
}

enum EventType {
  SEMINAR
  WEBINAR
  WORKSHOP
  CONFERENCE
  EDITORIAL_SESSION
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model Event {
  id              String      @id @default(cuid())
  journalId       String
  title           String
  slug            String
  description     String
  eventType       EventType   @default(WEBINAR)
  startsAt        DateTime
  endsAt          DateTime?
  speakerName     String?
  speakerTitle    String?
  registrationUrl String?
  recordingUrl    String?
  status          EventStatus @default(UPCOMING)
  isPublished     Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  journal         Journal     @relation(fields: [journalId], references: [id], onDelete: Cascade)
  registrations   EventRegistration[]

  @@unique([journalId, slug])
  @@index([journalId])
  @@index([status])
}

/**
 * One row per person who registered for an event. Registration
 * emails were previously fire-and-forget with no persisted record,
 * so there was no way to see how many people had registered.
 */
model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  email     String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId])
}

model UserJournalRole {
  id        String   @id @default(cuid())
  userId    String
  journalId String
  role      UserRole
  createdAt DateTime @default(now())
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, journalId, role])
  @@index([journalId])
  @@index([role])
}

model EditorialBoardMember {
  id          String   @id @default(cuid())
  journalId   String
  name        String
  title       String?
  affiliation String?
  country     String?
  email       String?
  role        String?
  photoUrl    String?
  bio         String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  journal     Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
}

model Volume {
  id          String   @id @default(cuid())
  journalId   String
  number      Int
  year        Int
  title       String?
  description String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  issues      Issue[]
  journal     Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, number, year])
  @@index([journalId])
}

model Issue {
  id           String    @id @default(cuid())
  journalId    String
  volumeId     String
  number       Int
  title        String?
  description  String?
  coverImage   String?
  editorial    String?
  fullIssuePdf String?
  slug         String?   @unique
  publishedAt  DateTime?
  isCurrent    Boolean   @default(false)
  isPublished  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  articles     Article[]
  journal      Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  volume       Volume    @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  @@unique([volumeId, number])
  @@index([journalId])
  @@index([volumeId])
}

model Submission {
  id                    String                 @id @default(cuid())
  displayId             String?                @unique
  journalId             String
  authorId              String
  title                 String
  abstract              String
  manuscriptType        String?
  invoice               Invoice?
  agreement             PublicationAgreement?
  status                SubmissionStatus       @default(DRAFT)
  coverLetter           String?
  submittedAt           DateTime?

  /*
   * Author declarations captured at submission time. "OBTAINED" or
   * "NOT_APPLICABLE" for ethics approval (plain String rather than a
   * new enum, since this is informational, not a workflow state).
   */
  declarationOriginalWork       Boolean?
  declarationNotUnderReview     Boolean?
  declarationConflictOfInterest Boolean?
  declarationEthicsApproval     String?
  declarationPolicyConsent      Boolean?
  declarationsAcceptedAt        DateTime?

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  currentReviewRound    Int                    @default(1)
  article               Article?
  decisions             EditorialDecision[]
  productionAssignments ProductionAssignment[]
  productionFiles       ProductionFile[]
  productionNotes       ProductionNote[]
  reviewAssignments     ReviewAssignment[]
  submissionAuthors     SubmissionAuthor[]
  author                User                   @relation("AuthorSubmissions", fields: [authorId], references: [id], onDelete: Cascade)
  journal               Journal                @relation(fields: [journalId], references: [id], onDelete: Cascade)
  files                 SubmissionFile[]
  keywords              SubmissionKeyword[]
  versions              SubmissionVersion[]

  referrerReviewerId String?
  referrerAssignedAt DateTime?

  referrerReviewer User?                     @relation("SubmissionReferrer", fields: [referrerReviewerId], references: [id], onDelete: SetNull)
  referralEvents   ReferralEvent[]
  conflictChecks   ConflictOfInterestCheck[]

  @@index([journalId])
  @@index([authorId])
  @@index([status])
  @@index([referrerReviewerId])
}

/**
 * Tracks the last-used sequence number per journal per year so
 * human-readable manuscript IDs (e.g. IJKRI-2026-001) can be handed
 * out atomically without colliding under concurrent submissions.
 */
model ManuscriptSequence {
  id         String   @id @default(cuid())
  journalId  String
  year       Int
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, year])
}

model SubmissionAuthor {
  id              String   @id @default(cuid())
  submissionId    String
  fullName        String
  email           String?
  affiliation     String?
  department      String?
  country         String?
  orcid           String?
  isCorresponding Boolean  @default(false)
  sortOrder       Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  agreementSignatures AgreementSignature[]

  @@index([submissionId])
  @@index([submissionId, sortOrder])
}

model SubmissionFile {
  id           String     @id @default(cuid())
  submissionId String
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int?
  label        String?
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model SubmissionVersion {
  id                 String             @id @default(cuid())
  submissionId       String
  uploadedById       String
  versionNumber      Int
  manuscriptFileUrl  String
  manuscriptFileName String?
  responseFileUrl    String?
  responseFileName   String?
  coverLetter        String?
  authorNotes        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  reviewAssignments  ReviewAssignment[]
  submission         Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploadedBy         User               @relation("SubmissionVersionUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@unique([submissionId, versionNumber])
  @@index([submissionId])
  @@index([uploadedById])
}

model Keyword {
  id          String              @id @default(cuid())
  name        String              @unique
  createdAt   DateTime            @default(now())
  articles    ArticleKeyword[]
  submissions SubmissionKeyword[]
}

model SubmissionKeyword {
  submissionId String
  keywordId    String
  keyword      Keyword    @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@id([submissionId, keywordId])
}

model Category {
  id        String    @id @default(cuid())
  journalId String
  name      String
  slug      String
  createdAt DateTime  @default(now())
  articles  Article[]
  journal   Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, slug])
  @@index([journalId])
}

model ReviewAssignment {
  id                  String             @id @default(cuid())
  submissionId        String
  reviewerId          String
  status              ReviewStatus       @default(INVITED)
  invitedAt           DateTime           @default(now())
  acceptedAt          DateTime?
  dueDate             DateTime?
  completedAt         DateTime?
  blindType           String             @default("DOUBLE_BLIND")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  reviewRound         Int                @default(1)
  submissionVersionId String?
  review              Review?
  reviewer            User               @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  submission          Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionVersion   SubmissionVersion? @relation(fields: [submissionVersionId], references: [id])

  editorialRating      Int?
  editorialRatingNotes String?
  editorialRatedById   String?
  editorialRatedAt     DateTime?

  editorialRatedBy User? @relation("ReviewAssignmentRatedBy", fields: [editorialRatedById], references: [id])

  @@unique([submissionId, reviewerId, reviewRound])
  @@index([reviewerId])
  @@index([submissionId])
  @@index([submissionVersionId])
  @@index([reviewRound])
  @@index([status])
  @@index([editorialRatedById])
}

model Review {
  id           String           @id @default(cuid())
  assignmentId String           @unique
  assignment   ReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  score            Int?
  recommendation   ReviewRecommendation
  commentsToAuthor String?
  commentsToEditor String?
  submittedAt      DateTime             @default(now())

  attachments ReviewAttachment[]
}

model ReviewAttachment {
  id          String   @id @default(cuid())
  reviewId    String
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  mimeType    String?
  fileSize    Int?
  description String?
  uploadedAt  DateTime @default(now())

  @@index([reviewId])
}

model EditorialDecision {
  id               String           @id @default(cuid())
  submissionId     String
  editorId         String
  decision         SubmissionStatus
  comments         String?
  createdAt        DateTime         @default(now())
  revisionDeadline DateTime?
  editor           User             @relation(fields: [editorId], references: [id], onDelete: Cascade)
  submission       Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([editorId])
}

model Article {
  id           String            @id @default(cuid())
  journalId    String
  issueId      String?
  categoryId   String?
  submissionId String?           @unique
  title        String
  slug         String
  abstract     String
  body         String?
  pdfUrl       String?
  doi          String?
  issn         String?
  startPage    Int?
  endPage      Int?
  status       ArticleStatus     @default(DRAFT)
  publishedAt  DateTime?
  accessType   ArticleAccessType @default(OPEN_ACCESS)

  purchases  ArticlePurchase[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  category   Category?          @relation(fields: [categoryId], references: [id])
  issue      Issue?             @relation(fields: [issueId], references: [id])
  journal    Journal            @relation(fields: [journalId], references: [id], onDelete: Cascade)
  submission Submission?        @relation(fields: [submissionId], references: [id])
  authors    ArticleAuthor[]
  keywords   ArticleKeyword[]
  references ArticleReference[]
  doiRecord  DoiRecord?

  @@unique([journalId, slug])
  @@index([journalId])
  @@index([issueId])
  @@index([status])
}

model ReviewerApplication {
  id                      String                    @id @default(cuid())
  journalId               String
  userId                  String?
  fullName                String
  email                   String
  phone                   String?
  affiliation             String
  department              String?
  country                 String
  currentPosition         String
  highestQualification    String
  primaryField            String
  secondaryFields         String?
  areasOfExpertise        String
  researchInterests       String?
  orcid                   String?
  googleScholarUrl        String?
  researchGateUrl         String?
  scopusId                String?
  webOfScienceId          String?
  profileUrl              String?
  yearsResearchExperience Int
  yearsReviewExperience   Int?
  publicationCount        Int?
  journalsReviewedFor     String?
  preferredTopics         String?
  availability            String?
  professionalStatement   String
  cvUrl                   String?
  recentPublicationUrl    String?
  conflictDeclaration     Boolean
  ethicsAgreement         Boolean
  dataConsent             Boolean
  status                  ReviewerApplicationStatus @default(PENDING)
  reviewNotes             String?
  reviewedById            String?
  reviewedAt              DateTime?
  submittedAt             DateTime                  @default(now())
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  journal                 Journal                   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  reviewedBy              User?                     @relation("ReviewerApplicationReviewer", fields: [reviewedById], references: [id])
  applicant               User?                     @relation("ReviewerApplicationApplicant", fields: [userId], references: [id])

  @@unique([journalId, email])
  @@index([journalId])
  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([reviewedById])
}

model ArticleAuthor {
  id              String  @id @default(cuid())
  articleId       String
  fullName        String
  email           String?
  affiliation     String?
  country         String?
  orcid           String?
  isCorresponding Boolean @default(false)
  sortOrder       Int     @default(0)
  article         Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model ArticleKeyword {
  articleId String
  keywordId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([articleId, keywordId])
}

model ArticleReference {
  id        String  @id @default(cuid())
  articleId String
  citation  String
  doi       String?
  url       String?
  sortOrder Int     @default(0)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model DoiRecord {
  id           String    @id @default(cuid())
  articleId    String?   @unique
  doi          String    @unique
  status       DOIStatus @default(PENDING)
  registeredAt DateTime?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  article      Article?  @relation(fields: [articleId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
}

model ActivityLog {
  id        String       @id @default(cuid())
  userId    String?
  action    ActivityType
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([action])
}

model ProductionAssignment {
  id           String           @id @default(cuid())
  submissionId String
  assigneeId   String
  assignedById String
  stage        ProductionStage
  status       ProductionStatus @default(PENDING)
  round        Int              @default(1)
  instructions String?
  dueDate      DateTime?
  startedAt    DateTime?
  submittedAt  DateTime?
  approvedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignedBy   User             @relation("ProductionAssignedBy", fields: [assignedById], references: [id])
  assignee     User             @relation("ProductionAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  files        ProductionFile[]
  notes        ProductionNote[]

  @@unique([submissionId, stage, round])
  @@index([submissionId])
  @@index([assigneeId])
  @@index([assignedById])
  @@index([stage])
  @@index([status])
}

model ProductionFile {
  id                     String                @id @default(cuid())
  submissionId           String
  productionAssignmentId String?
  uploadedById           String
  fileType               ProductionFileType
  fileName               String
  fileUrl                String
  mimeType               String?
  fileSize               Int?
  versionNumber          Int                   @default(1)
  description            String?
  isFinal                Boolean               @default(false)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  productionAssignment   ProductionAssignment? @relation(fields: [productionAssignmentId], references: [id])
  submission             Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploadedBy             User                  @relation("ProductionFileUploader", fields: [uploadedById], references: [id])

  @@index([submissionId])
  @@index([productionAssignmentId])
  @@index([uploadedById])
  @@index([fileType])
  @@index([isFinal])
}

model ProductionNote {
  id                     String                @id @default(cuid())
  submissionId           String
  productionAssignmentId String?
  authorId               String
  message                String
  isInternal             Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  author                 User                  @relation("ProductionNoteAuthor", fields: [authorId], references: [id])
  productionAssignment   ProductionAssignment? @relation(fields: [productionAssignmentId], references: [id], onDelete: Cascade)
  submission             Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([productionAssignmentId])
  @@index([authorId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CareerApplication {
  id                    String                  @id @default(cuid())
  journalId             String
  userId                String?
  position              CareerPosition
  fullName              String
  email                 String
  phone                 String?
  country               String
  affiliation           String?
  department            String?
  currentPosition       String?
  highestQualification  String
  fieldOfStudy          String?
  yearsExperience       Int
  publicationCount      Int?
  areasOfExpertise      String?
  professionalSkills    String?
  orcid                 String?
  googleScholarUrl      String?
  researchGateUrl       String?
  linkedinUrl           String?
  scopusId              String?
  webOfScienceId        String?
  cvUrl                 String?
  coverLetterUrl        String?
  certificatesUrl       String?
  portfolioUrl          String?
  professionalStatement String
  availability          String?
  salaryExpectation     String?
  consentAccepted       Boolean                 @default(false)
  declarationAccepted   Boolean                 @default(false)
  status                CareerApplicationStatus @default(PENDING)
  reviewNotes           String?
  interviewDate         DateTime?
  reviewedById          String?
  reviewedAt            DateTime?
  submittedAt           DateTime                @default(now())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  journal               Journal                 @relation(fields: [journalId], references: [id], onDelete: Cascade)
  reviewedBy            User?                   @relation("CareerApplicationReviewer", fields: [reviewedById], references: [id])
  applicant             User?                   @relation("CareerApplicationApplicant", fields: [userId], references: [id])

  @@index([journalId])
  @@index([userId])
  @@index([email])
  @@index([position])
  @@index([status])
  @@index([reviewedById])
}

/// One row per reviewer who has been approved (created inside
/// approveReviewerApplication's transaction). This is the ambassador
/// "identity" record; referral FKs elsewhere point at User.id (not this
/// id) to stay consistent with existing reviewerId conventions.
model ReviewerAmbassador {
  id                     String           @id @default(cuid())
  userId                 String           @unique
  journalId              String
  referralCode           String           @unique
  status                 AmbassadorStatus @default(ACTIVE)
  level                  AmbassadorLevel  @default(NONE)
  publishedReferralCount Int              @default(0)
  totalReferralCount     Int              @default(0)
  levelAchievedAt        DateTime?
  suspendedAt            DateTime?
  suspendedReason        String?
  suspendedById          String?
  regeneratedCount       Int              @default(0)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  slug                   String? @unique
  isPublicProfileEnabled Boolean @default(false)
  contactEnabled         Boolean @default(false)

  user                 User                          @relation("AmbassadorUser", fields: [userId], references: [id], onDelete: Cascade)
  journal              Journal                       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  suspendedBy          User?                         @relation("AmbassadorSuspendedBy", fields: [suspendedById], references: [id])
  wallet               AmbassadorWallet?
  payoutAccount        AmbassadorPayoutAccount?
  certificates         AmbassadorCertificate[]
  withdrawals          WithdrawalRequest[]
  performanceSnapshots ReviewerPerformanceSnapshot[]

  @@index([journalId])
  @@index([status])
  @@index([level])
}

model AmbassadorWallet {
  id               String   @id @default(cuid())
  ambassadorId     String   @unique
  currentBalance   Decimal  @default(0) @db.Decimal(12, 2)
  pendingBalance   Decimal  @default(0) @db.Decimal(12, 2)
  lifetimeEarnings Decimal  @default(0) @db.Decimal(12, 2)
  totalWithdrawn   Decimal  @default(0) @db.Decimal(12, 2)
  currency         Currency @default(USD)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ambassador   ReviewerAmbassador  @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  withdrawals  WithdrawalRequest[]

  @@index([ambassadorId])
}

/// Append-only ledger. idempotencyKey is the double-crediting guard.
model WalletTransaction {
  id             String                     @id @default(cuid())
  walletId       String
  type           WalletTransactionType
  direction      WalletTransactionDirection
  amount         Decimal                    @db.Decimal(12, 2)
  currency       Currency                   @default(USD)
  balanceAfter   Decimal                    @db.Decimal(12, 2)
  status         WalletTransactionStatus    @default(COMPLETED)
  idempotencyKey String                     @unique
  sourceType     String?
  sourceId       String?
  description    String
  createdById    String?
  createdAt      DateTime                   @default(now())

  wallet    AmbassadorWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("WalletTransactionCreatedBy", fields: [createdById], references: [id])

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([sourceType, sourceId])
}

/// One settings row per journal — admin-configurable, never hardcoded.
model AmbassadorRewardSetting {
  id                String   @id @default(cuid())
  journalId         String   @unique
  reviewReward      Decimal  @default(0) @db.Decimal(12, 2)
  submissionReward  Decimal  @default(0) @db.Decimal(12, 2)
  publicationReward Decimal  @default(0) @db.Decimal(12, 2)
  referralBonus     Decimal  @default(0) @db.Decimal(12, 2)
  currency          Currency @default(USD)
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("RewardSettingUpdatedBy", fields: [updatedById], references: [id])
}

model AmbassadorPayoutAccount {
  id                    String    @id @default(cuid())
  ambassadorId          String    @unique
  bankCode              String
  bankName              String
  accountNumber         String
  accountName           String
  paystackRecipientCode String?   @unique
  verifiedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  ambassador         ReviewerAmbassador  @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  withdrawalRequests WithdrawalRequest[]
}

model WithdrawalRequest {
  id                   String           @id @default(cuid())
  walletId             String
  ambassadorId         String
  payoutAccountId      String
  amount               Decimal          @db.Decimal(12, 2)
  currency             Currency         @default(USD)
  status               WithdrawalStatus @default(PENDING)
  internalReference    String           @unique
  paystackTransferCode String?          @unique
  paystackTransferId   String?          @unique
  failureReason        String?
  requestedAt          DateTime         @default(now())
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNotes          String?
  paidAt               DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  wallet        AmbassadorWallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  ambassador    ReviewerAmbassador      @relation(fields: [ambassadorId], references: [id], onDelete: Restrict)
  payoutAccount AmbassadorPayoutAccount @relation(fields: [payoutAccountId], references: [id], onDelete: Restrict)
  reviewedBy    User?                   @relation("WithdrawalReviewedBy", fields: [reviewedById], references: [id])
  webhookLogs   PaymentWebhookLog[]

  @@index([walletId])
  @@index([ambassadorId])
  @@index([status])
  @@index([requestedAt])
}

model AmbassadorCertificate {
  id                String          @id @default(cuid())
  ambassadorId      String
  type              CertificateType
  title             String
  certificateNumber String          @unique
  periodLabel       String?
  metadata          Json?
  issuedAt          DateTime        @default(now())
  revoked           Boolean         @default(false)

  ambassador ReviewerAmbassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)

  @@unique([ambassadorId, type, periodLabel])
  @@index([ambassadorId])
  @@index([type])
}

/// Append-only referral timeline + "Recent Referral Activity" feed source.
model ReferralEvent {
  id             String        @id @default(cuid())
  reviewerId     String
  referredUserId String?
  submissionId   String?
  stage          ReferralStage
  metadata       Json?
  occurredAt     DateTime      @default(now())

  reviewer     User        @relation("ReferralEventReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  referredUser User?       @relation("ReferralEventReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([reviewerId])
  @@index([submissionId])
  @@index([stage])
  @@index([occurredAt])
}

/// Append-only, like WalletTransaction — "current score" = latest row,
/// "score history" = the full table.
model ReviewerPerformanceSnapshot {
  id           String     @id @default(cuid())
  ambassadorId String
  overallScore Int
  grade        ScoreGrade
  trend        ScoreTrend @default(STABLE)
  breakdown    Json
  strengths    Json
  improvements Json
  calculatedAt DateTime   @default(now())

  ambassador ReviewerAmbassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)

  @@index([ambassadorId, calculatedAt])
}

/// One row per journal. Super-Admin-configurable weights (must sum to
/// 100 at the app layer; enforced in the update action, not the DB).
model ReviewerScoringSettings {
  id                           String   @id @default(cuid())
  journalId                    String   @unique
  reviewQualityWeight          Int      @default(20)
  completionTimeWeight         Int      @default(15)
  editorialRatingWeight        Int      @default(15)
  completedReviewsWeight       Int      @default(10)
  invitationAcceptanceWeight   Int      @default(10)
  referralPublicationWeight    Int      @default(10)
  latePenaltyWeight            Int      @default(10)
  recommendationAccuracyWeight Int      @default(5)
  withdrawalPenaltyWeight      Int      @default(5)
  updatedById                  String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("ScoringSettingsUpdatedBy", fields: [updatedById], references: [id])
}

/// Admin-uploaded background per asset type; overlaid with the reviewer's
/// name/code/QR at generation time (never pre-rendered per-reviewer).
model MarketingTemplate {
  id                 String             @id @default(cuid())
  journalId          String
  assetType          MarketingAssetType
  backgroundImageUrl String
  defaultCaption     String?
  isActive           Boolean            @default(true)
  createdById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  createdBy User    @relation("MarketingTemplateCreatedBy", fields: [createdById], references: [id])

  @@index([journalId, assetType])
  @@index([journalId, assetType, isActive])
}

model ReferralCampaign {
  id                String         @id @default(cuid())
  journalId         String
  name              String
  description       String?
  rewardMultiplier  Decimal        @default(1) @db.Decimal(4, 2)
  reviewBonus       Decimal        @default(0) @db.Decimal(12, 2)
  submissionBonus   Decimal        @default(0) @db.Decimal(12, 2)
  publicationBonus  Decimal        @default(0) @db.Decimal(12, 2)
  referralBonus     Decimal        @default(0) @db.Decimal(12, 2)
  startDate         DateTime
  endDate           DateTime
  targetDiscipline  String?
  targetCountry     String?
  targetInstitution String?
  maxBudget         Decimal?       @db.Decimal(12, 2)
  spentBudget       Decimal        @default(0) @db.Decimal(12, 2)
  bannerImageUrl    String?
  status            CampaignStatus @default(DRAFT)
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  journal   Journal             @relation(fields: [journalId], references: [id], onDelete: Cascade)
  createdBy User                @relation("ReferralCampaignCreatedBy", fields: [createdById], references: [id])
  rewards   CampaignRewardLog[]

  @@index([journalId, status])
  @@index([startDate, endDate])
}

/// Audit trail of every bonus a campaign paid out — drives spentBudget
/// and gives Super Admin a per-campaign ledger.
model CampaignRewardLog {
  id                  String   @id @default(cuid())
  campaignId          String
  walletTransactionId String   @unique
  submissionId        String?
  amount              Decimal  @db.Decimal(12, 2)
  appliedAt           DateTime @default(now())

  campaign ReferralCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

/// One row per detected conflict per submission+reviewer pair — both the
/// live signal and the permanent audit record.
model ConflictOfInterestCheck {
  id             String           @id @default(cuid())
  submissionId   String
  reviewerId     String
  conflictType   ConflictType
  severity       ConflictSeverity
  reason         String
  recommendation String
  blocked        Boolean          @default(false)
  overriddenById String?
  overriddenAt   DateTime?
  overrideReason String?
  detectedAt     DateTime         @default(now())

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer     User       @relation("ConflictReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  overriddenBy User?      @relation("ConflictOverriddenBy", fields: [overriddenById], references: [id])

  @@index([submissionId])
  @@index([reviewerId])
  @@index([severity])
}

/// Public ORCID record data (NOT the OAuth identity link, which stays on
/// User.orcid/orcidVerifiedAt). Refreshed on demand via ORCID's public API.
model OrcidProfileSnapshot {
  id               String   @id @default(cuid())
  userId           String   @unique
  biography        String?
  employments      Json?
  educations       Json?
  keywords         Json?
  worksCount       Int      @default(0)
  publicProfileUrl String
  syncedAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

