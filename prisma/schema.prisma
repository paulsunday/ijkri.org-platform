generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  domain    String?
  logo      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  journals  Journal[]

  @@index([slug])
}

model Publisher {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  address   String?
  website   String?
  email     String?
  phone     String?
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  journals  Journal[]

  @@index([slug])
}

model Invoice {
  id            String        @id @default(cuid())
  journalId     String
  submissionId  String        @unique
  userId        String
  invoiceNumber String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  currency      Currency      @default(USD)
  status        InvoiceStatus @default(PENDING)
  dueAt         DateTime?
  paidAt        DateTime?
  waivedAt      DateTime?
  waivedAmount  Decimal?      @db.Decimal(10, 2)
  waivedReason  String?
  waivedById    String?
  voidedAt      DateTime?
  waivedBy      User?         @relation("InvoiceWaiverApprover", fields: [waivedById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  journal    Journal    @relation(fields: [journalId], references: [id], onDelete: Restrict)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments   Payment[]

  @@index([journalId])
  @@index([userId])
  @@index([status])
  @@index([dueAt])
  @@index([waivedById])
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String
  processedById     String?
  amount            Decimal      @db.Decimal(10, 2)
  currency          Currency     @default(USD)
  status            RefundStatus @default(PENDING)
  internalReference String       @unique
  providerReference String?      @unique
  reason            String
  providerResponse  Json?
  failureReason     String?
  requestedAt       DateTime     @default(now())
  processedAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  processedBy User?   @relation("RefundProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([processedById])
  @@index([status])
  @@index([requestedAt])
}

model Payment {
  id                String          @id @default(cuid())
  journalId         String
  userId            String
  invoiceId         String?
  subscriptionId    String?
  articlePurchaseId String?
  providerStatus    String?
  providerChannel   String?
  providerFees      Decimal?        @db.Decimal(10, 2)
  paidAmount        Decimal?        @db.Decimal(10, 2)
  customerEmail     String?
  verifiedAt        DateTime?
  purpose           PaymentPurpose
  provider          PaymentProvider @default(PAYSTACK)
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(10, 2)
  currency          Currency        @default(USD)
  internalReference String          @unique
  providerReference String?         @unique
  receiptNumber     String?         @unique
  authorizationUrl  String?
  providerResponse  Json?
  failureReason     String?
  initiatedAt       DateTime        @default(now())
  paidAt            DateTime?
  failedAt          DateTime?
  cancelledAt       DateTime?
  refundedAt        DateTime?
  refundedAmount    Decimal?        @db.Decimal(10, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  journal         Journal             @relation(fields: [journalId], references: [id], onDelete: Restrict)
  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  invoice         Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  subscription    Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  articlePurchase ArticlePurchase?    @relation(fields: [articlePurchaseId], references: [id], onDelete: SetNull)
  refunds         Refund[]
  webhookLogs     PaymentWebhookLog[]

  @@index([journalId])
  @@index([userId])
  @@index([invoiceId])
  @@index([subscriptionId])
  @@index([articlePurchaseId])
  @@index([purpose])
  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id          String             @id @default(cuid())
  journalId   String
  userId      String
  status      SubscriptionStatus @default(PENDING)
  amount      Decimal            @db.Decimal(10, 2)
  currency    Currency           @default(USD)
  startsAt    DateTime?
  expiresAt   DateTime?
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  journal        Journal   @relation(fields: [journalId], references: [id], onDelete: Restrict)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments       Payment[]
  durationMonths Int       @default(1)
  planName       String    @default("Reader Subscription")

  @@index([journalId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model ArticlePurchase {
  id              String    @id @default(cuid())
  journalId       String
  articleId       String
  userId          String
  amount          Decimal   @db.Decimal(10, 2)
  currency        Currency  @default(USD)
  accessGrantedAt DateTime?
  accessRevokedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  journal  Journal   @relation(fields: [journalId], references: [id], onDelete: Restrict)
  article  Article   @relation(fields: [articleId], references: [id], onDelete: Restrict)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([userId, articleId])
  @@index([journalId])
  @@index([articleId])
  @@index([userId])
  @@index([accessGrantedAt])
}

model PaymentWebhookLog {
  id                 String          @id @default(cuid())
  paymentId          String?
  provider           PaymentProvider @default(PAYSTACK)
  providerEventId    String?         @unique
  eventType          String
  signatureValid     Boolean         @default(false)
  processed          Boolean         @default(false)
  processingAttempts Int             @default(0)
  payload            Json
  errorMessage       String?
  receivedAt         DateTime        @default(now())
  lastAttemptAt      DateTime?
  processedAt        DateTime?

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([eventType])
  @@index([processed])
  @@index([receivedAt])
}

model User {
  id                         String              @id @default(cuid())
  name                       String
  email                      String              @unique
  passwordHash               String?
  image                      String?
  orcid                      String?
  orcidVerifiedAt            DateTime?
  bio                        String?
  affiliation                String?
  country                    String?
  phone                      String?
  lastLogin                  DateTime?
  isActive                   Boolean             @default(true)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  emailVerified              DateTime?
  failedLoginAttempts        Int                 @default(0)
  lockedUntil                DateTime?
  passwordChangedAt          DateTime?
  reviewedCareerApplications CareerApplication[] @relation("CareerApplicationReviewer")
  careerApplications         CareerApplication[] @relation("CareerApplicationApplicant")
  decisions                  EditorialDecision[]
  notifications              Notification[]
  invoices                   Invoice[]
  payments                   Payment[]
  subscriptions              Subscription[]
  articlePurchases           ArticlePurchase[]

  passwordResetTokens          PasswordResetToken[]
  createdProductionTasks       ProductionAssignment[] @relation("ProductionAssignedBy")
  assignedProductionTasks      ProductionAssignment[] @relation("ProductionAssignee")
  uploadedProductionFiles      ProductionFile[]       @relation("ProductionFileUploader")
  productionNotes              ProductionNote[]       @relation("ProductionNoteAuthor")
  reviews                      ReviewAssignment[]
  reviewedReviewerApplications ReviewerApplication[]  @relation("ReviewerApplicationReviewer")
  reviewerApplications         ReviewerApplication[]  @relation("ReviewerApplicationApplicant")
  submissions                  Submission[]           @relation("AuthorSubmissions")
  uploadedSubmissionVersions   SubmissionVersion[]    @relation("SubmissionVersionUploader")
  roles                        UserJournalRole[]
  processedRefunds             Refund[]               @relation("RefundProcessor")
  approvedInvoiceWaivers       Invoice[]              @relation("InvoiceWaiverApprover")

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Journal {
  id                   String                 @id @default(cuid())
  tenantId             String
  publisherId          String?
  name                 String
  shortName            String
  slug                 String                 @unique
  issnPrint            String?
  issnOnline           String?
  description          String?
  aimsScope            String?
  authorGuidelines     String?
  ethicsPolicy         String?
  peerReviewPolicy     String?
  openAccessPolicy     String?
  apcInfo              String?
  contactEmail         String?
  websiteUrl           String?
  logo                 String?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  articles             Article[]
  invoices             Invoice[]
  payments             Payment[]
  subscriptions        Subscription[]
  articlePurchases     ArticlePurchase[]
  careerApplications   CareerApplication[]
  categories           Category[]
  editorialBoards      EditorialBoardMember[]
  issues               Issue[]
  publisher            Publisher?             @relation(fields: [publisherId], references: [id])
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settings             JournalSettings?
  reviewerApplications ReviewerApplication[]
  submissions          Submission[]
  roles                UserJournalRole[]
  volumes              Volume[]

  apcAmount          Decimal  @default(97.00) @db.Decimal(10, 2)
  subscriptionAmount Decimal  @default(6.00) @db.Decimal(10, 2)
  articlePrice       Decimal  @default(2.00) @db.Decimal(10, 2)
  currency           Currency @default(USD)

  @@index([slug])
  @@index([tenantId])
  @@index([publisherId])
}

model JournalSettings {
  id                  String   @id @default(cuid())
  journalId           String   @unique
  submissionOpen      Boolean  @default(true)
  reviewType          String   @default("DOUBLE_BLIND")
  plagiarismThreshold Int?
  defaultLanguage     String   @default("English")
  theme               String?
  homepageBanner      String?
  contactAddress      String?
  copyrightPolicy     String?
  license             String?
  footerText          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  journal             Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
}

model UserJournalRole {
  id        String   @id @default(cuid())
  userId    String
  journalId String
  role      UserRole
  createdAt DateTime @default(now())
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, journalId, role])
  @@index([journalId])
  @@index([role])
}

model EditorialBoardMember {
  id          String   @id @default(cuid())
  journalId   String
  name        String
  title       String?
  affiliation String?
  country     String?
  email       String?
  role        String?
  photoUrl    String?
  bio         String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  journal     Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
}

model Volume {
  id          String   @id @default(cuid())
  journalId   String
  number      Int
  year        Int
  title       String?
  description String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  issues      Issue[]
  journal     Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, number, year])
  @@index([journalId])
}

model Issue {
  id           String    @id @default(cuid())
  journalId    String
  volumeId     String
  number       Int
  title        String?
  description  String?
  coverImage   String?
  editorial    String?
  fullIssuePdf String?
  slug         String?   @unique
  publishedAt  DateTime?
  isCurrent    Boolean   @default(false)
  isPublished  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  articles     Article[]
  journal      Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  volume       Volume    @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  @@unique([volumeId, number])
  @@index([journalId])
  @@index([volumeId])
}

model Submission {
  id                    String                 @id @default(cuid())
  journalId             String
  authorId              String
  title                 String
  abstract              String
  manuscriptType        String?
  invoice               Invoice?
  status                SubmissionStatus       @default(DRAFT)
  coverLetter           String?
  submittedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  currentReviewRound    Int                    @default(1)
  article               Article?
  decisions             EditorialDecision[]
  productionAssignments ProductionAssignment[]
  productionFiles       ProductionFile[]
  productionNotes       ProductionNote[]
  reviewAssignments     ReviewAssignment[]
  submissionAuthors     SubmissionAuthor[]
  author                User                   @relation("AuthorSubmissions", fields: [authorId], references: [id], onDelete: Cascade)
  journal               Journal                @relation(fields: [journalId], references: [id], onDelete: Cascade)
  files                 SubmissionFile[]
  keywords              SubmissionKeyword[]
  versions              SubmissionVersion[]

  @@index([journalId])
  @@index([authorId])
  @@index([status])
}

model SubmissionAuthor {
  id              String   @id @default(cuid())
  submissionId    String
  fullName        String
  email           String?
  affiliation     String?
  department      String?
  country         String?
  orcid           String?
  isCorresponding Boolean  @default(false)
  sortOrder       Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([submissionId, sortOrder])
}

model SubmissionFile {
  id           String     @id @default(cuid())
  submissionId String
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int?
  label        String?
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model SubmissionVersion {
  id                 String             @id @default(cuid())
  submissionId       String
  uploadedById       String
  versionNumber      Int
  manuscriptFileUrl  String
  manuscriptFileName String?
  responseFileUrl    String?
  responseFileName   String?
  coverLetter        String?
  authorNotes        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  reviewAssignments  ReviewAssignment[]
  submission         Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploadedBy         User               @relation("SubmissionVersionUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@unique([submissionId, versionNumber])
  @@index([submissionId])
  @@index([uploadedById])
}

model Keyword {
  id          String              @id @default(cuid())
  name        String              @unique
  createdAt   DateTime            @default(now())
  articles    ArticleKeyword[]
  submissions SubmissionKeyword[]
}

model SubmissionKeyword {
  submissionId String
  keywordId    String
  keyword      Keyword    @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@id([submissionId, keywordId])
}

model Category {
  id        String    @id @default(cuid())
  journalId String
  name      String
  slug      String
  createdAt DateTime  @default(now())
  articles  Article[]
  journal   Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, slug])
  @@index([journalId])
}

model ReviewAssignment {
  id                  String             @id @default(cuid())
  submissionId        String
  reviewerId          String
  status              ReviewStatus       @default(INVITED)
  invitedAt           DateTime           @default(now())
  acceptedAt          DateTime?
  dueDate             DateTime?
  completedAt         DateTime?
  blindType           String             @default("DOUBLE_BLIND")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  reviewRound         Int                @default(1)
  submissionVersionId String?
  review              Review?
  reviewer            User               @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  submission          Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionVersion   SubmissionVersion? @relation(fields: [submissionVersionId], references: [id])

  @@unique([submissionId, reviewerId, reviewRound])
  @@index([reviewerId])
  @@index([submissionId])
  @@index([submissionVersionId])
  @@index([reviewRound])
  @@index([status])
}

model Review {
  id           String           @id @default(cuid())
  assignmentId String           @unique
  assignment   ReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  score            Int?
  recommendation   ReviewRecommendation
  commentsToAuthor String?
  commentsToEditor String?
  submittedAt      DateTime             @default(now())

  attachments ReviewAttachment[]
}

model ReviewAttachment {
  id          String   @id @default(cuid())
  reviewId    String
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  mimeType    String?
  fileSize    Int?
  description String?
  uploadedAt  DateTime @default(now())

  @@index([reviewId])
}

model EditorialDecision {
  id               String           @id @default(cuid())
  submissionId     String
  editorId         String
  decision         SubmissionStatus
  comments         String?
  createdAt        DateTime         @default(now())
  revisionDeadline DateTime?
  editor           User             @relation(fields: [editorId], references: [id], onDelete: Cascade)
  submission       Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([editorId])
}

model Article {
  id           String            @id @default(cuid())
  journalId    String
  issueId      String?
  categoryId   String?
  submissionId String?           @unique
  title        String
  slug         String
  abstract     String
  body         String?
  pdfUrl       String?
  doi          String?
  startPage    Int?
  endPage      Int?
  status       ArticleStatus     @default(DRAFT)
  publishedAt  DateTime?
  accessType   ArticleAccessType @default(OPEN_ACCESS)

  purchases  ArticlePurchase[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  category   Category?          @relation(fields: [categoryId], references: [id])
  issue      Issue?             @relation(fields: [issueId], references: [id])
  journal    Journal            @relation(fields: [journalId], references: [id], onDelete: Cascade)
  submission Submission?        @relation(fields: [submissionId], references: [id])
  authors    ArticleAuthor[]
  keywords   ArticleKeyword[]
  references ArticleReference[]
  doiRecord  DoiRecord?

  @@unique([journalId, slug])
  @@index([journalId])
  @@index([issueId])
  @@index([status])
}

model ReviewerApplication {
  id                      String                    @id @default(cuid())
  journalId               String
  userId                  String?
  fullName                String
  email                   String
  phone                   String?
  affiliation             String
  department              String?
  country                 String
  currentPosition         String
  highestQualification    String
  primaryField            String
  secondaryFields         String?
  areasOfExpertise        String
  researchInterests       String?
  orcid                   String?
  googleScholarUrl        String?
  researchGateUrl         String?
  scopusId                String?
  webOfScienceId          String?
  profileUrl              String?
  yearsResearchExperience Int
  yearsReviewExperience   Int?
  publicationCount        Int?
  journalsReviewedFor     String?
  preferredTopics         String?
  availability            String?
  professionalStatement   String
  cvUrl                   String?
  recentPublicationUrl    String?
  conflictDeclaration     Boolean
  ethicsAgreement         Boolean
  dataConsent             Boolean
  status                  ReviewerApplicationStatus @default(PENDING)
  reviewNotes             String?
  reviewedById            String?
  reviewedAt              DateTime?
  submittedAt             DateTime                  @default(now())
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  journal                 Journal                   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  reviewedBy              User?                     @relation("ReviewerApplicationReviewer", fields: [reviewedById], references: [id])
  applicant               User?                     @relation("ReviewerApplicationApplicant", fields: [userId], references: [id])

  @@unique([journalId, email])
  @@index([journalId])
  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([reviewedById])
}

model ArticleAuthor {
  id          String  @id @default(cuid())
  articleId   String
  fullName    String
  email       String?
  affiliation String?
  country     String?
  orcid       String?
  sortOrder   Int     @default(0)
  article     Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model ArticleKeyword {
  articleId String
  keywordId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([articleId, keywordId])
}

model ArticleReference {
  id        String  @id @default(cuid())
  articleId String
  citation  String
  doi       String?
  url       String?
  sortOrder Int     @default(0)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model DoiRecord {
  id           String    @id @default(cuid())
  articleId    String?   @unique
  doi          String    @unique
  status       DOIStatus @default(PENDING)
  registeredAt DateTime?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  article      Article?  @relation(fields: [articleId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
}

model ActivityLog {
  id        String       @id @default(cuid())
  userId    String?
  action    ActivityType
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([action])
}

model ProductionAssignment {
  id           String           @id @default(cuid())
  submissionId String
  assigneeId   String
  assignedById String
  stage        ProductionStage
  status       ProductionStatus @default(PENDING)
  round        Int              @default(1)
  instructions String?
  dueDate      DateTime?
  startedAt    DateTime?
  submittedAt  DateTime?
  approvedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignedBy   User             @relation("ProductionAssignedBy", fields: [assignedById], references: [id])
  assignee     User             @relation("ProductionAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  files        ProductionFile[]
  notes        ProductionNote[]

  @@unique([submissionId, stage, round])
  @@index([submissionId])
  @@index([assigneeId])
  @@index([assignedById])
  @@index([stage])
  @@index([status])
}

model ProductionFile {
  id                     String                @id @default(cuid())
  submissionId           String
  productionAssignmentId String?
  uploadedById           String
  fileType               ProductionFileType
  fileName               String
  fileUrl                String
  mimeType               String?
  fileSize               Int?
  versionNumber          Int                   @default(1)
  description            String?
  isFinal                Boolean               @default(false)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  productionAssignment   ProductionAssignment? @relation(fields: [productionAssignmentId], references: [id])
  submission             Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploadedBy             User                  @relation("ProductionFileUploader", fields: [uploadedById], references: [id])

  @@index([submissionId])
  @@index([productionAssignmentId])
  @@index([uploadedById])
  @@index([fileType])
  @@index([isFinal])
}

model ProductionNote {
  id                     String                @id @default(cuid())
  submissionId           String
  productionAssignmentId String?
  authorId               String
  message                String
  isInternal             Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  author                 User                  @relation("ProductionNoteAuthor", fields: [authorId], references: [id])
  productionAssignment   ProductionAssignment? @relation(fields: [productionAssignmentId], references: [id], onDelete: Cascade)
  submission             Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([productionAssignmentId])
  @@index([authorId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CareerApplication {
  id                    String                  @id @default(cuid())
  journalId             String
  userId                String?
  position              CareerPosition
  fullName              String
  email                 String
  phone                 String?
  country               String
  affiliation           String?
  department            String?
  currentPosition       String?
  highestQualification  String
  fieldOfStudy          String?
  yearsExperience       Int
  publicationCount      Int?
  areasOfExpertise      String?
  professionalSkills    String?
  orcid                 String?
  googleScholarUrl      String?
  researchGateUrl       String?
  linkedinUrl           String?
  scopusId              String?
  webOfScienceId        String?
  cvUrl                 String?
  coverLetterUrl        String?
  certificatesUrl       String?
  portfolioUrl          String?
  professionalStatement String
  availability          String?
  salaryExpectation     String?
  consentAccepted       Boolean                 @default(false)
  declarationAccepted   Boolean                 @default(false)
  status                CareerApplicationStatus @default(PENDING)
  reviewNotes           String?
  interviewDate         DateTime?
  reviewedById          String?
  reviewedAt            DateTime?
  submittedAt           DateTime                @default(now())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  journal               Journal                 @relation(fields: [journalId], references: [id], onDelete: Cascade)
  reviewedBy            User?                   @relation("CareerApplicationReviewer", fields: [reviewedById], references: [id])
  applicant             User?                   @relation("CareerApplicationApplicant", fields: [userId], references: [id])

  @@index([journalId])
  @@index([userId])
  @@index([email])
  @@index([position])
  @@index([status])
  @@index([reviewedById])
}

