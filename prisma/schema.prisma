generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  domain    String?
  logo      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  journals  Journal[]

  @@index([slug])
}

model Publisher {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  address   String?
  website   String?
  email     String?
  phone     String?
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  journals  Journal[]

  @@index([slug])
}

model User {
  id                           String                 @id @default(cuid())
  name                         String
  email                        String                 @unique
  passwordHash                 String?
  image                        String?
  orcid                        String?
  bio                          String?
  affiliation                  String?
  country                      String?
  phone                        String?
  lastLogin                    DateTime?
  isActive                     Boolean                @default(true)
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  emailVerified                DateTime?
  failedLoginAttempts          Int                    @default(0)
  lockedUntil                  DateTime?
  passwordChangedAt            DateTime?
  reviewedCareerApplications   CareerApplication[]    @relation("CareerApplicationReviewer")
  careerApplications           CareerApplication[]    @relation("CareerApplicationApplicant")
  decisions                    EditorialDecision[]
  notifications                Notification[]
  passwordResetTokens          PasswordResetToken[]
  createdProductionTasks       ProductionAssignment[] @relation("ProductionAssignedBy")
  assignedProductionTasks      ProductionAssignment[] @relation("ProductionAssignee")
  uploadedProductionFiles      ProductionFile[]       @relation("ProductionFileUploader")
  productionNotes              ProductionNote[]       @relation("ProductionNoteAuthor")
  reviews                      ReviewAssignment[]
  reviewedReviewerApplications ReviewerApplication[]  @relation("ReviewerApplicationReviewer")
  reviewerApplications         ReviewerApplication[]  @relation("ReviewerApplicationApplicant")
  submissions                  Submission[]           @relation("AuthorSubmissions")
  uploadedSubmissionVersions   SubmissionVersion[]    @relation("SubmissionVersionUploader")
  roles                        UserJournalRole[]

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Journal {
  id                   String                 @id @default(cuid())
  tenantId             String
  publisherId          String?
  name                 String
  shortName            String
  slug                 String                 @unique
  issnPrint            String?
  issnOnline           String?
  description          String?
  aimsScope            String?
  authorGuidelines     String?
  ethicsPolicy         String?
  peerReviewPolicy     String?
  openAccessPolicy     String?
  apcInfo              String?
  contactEmail         String?
  websiteUrl           String?
  logo                 String?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  articles             Article[]
  careerApplications   CareerApplication[]
  categories           Category[]
  editorialBoards      EditorialBoardMember[]
  issues               Issue[]
  publisher            Publisher?             @relation(fields: [publisherId], references: [id])
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settings             JournalSettings?
  reviewerApplications ReviewerApplication[]
  submissions          Submission[]
  roles                UserJournalRole[]
  volumes              Volume[]

  @@index([slug])
  @@index([tenantId])
  @@index([publisherId])
}

model JournalSettings {
  id                  String   @id @default(cuid())
  journalId           String   @unique
  submissionOpen      Boolean  @default(true)
  reviewType          String   @default("DOUBLE_BLIND")
  plagiarismThreshold Int?
  defaultLanguage     String   @default("English")
  theme               String?
  homepageBanner      String?
  contactAddress      String?
  copyrightPolicy     String?
  license             String?
  footerText          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  journal             Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
}

model UserJournalRole {
  id        String   @id @default(cuid())
  userId    String
  journalId String
  role      UserRole
  createdAt DateTime @default(now())
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, journalId, role])
  @@index([journalId])
  @@index([role])
}

model EditorialBoardMember {
  id          String   @id @default(cuid())
  journalId   String
  name        String
  title       String?
  affiliation String?
  country     String?
  email       String?
  role        String?
  photoUrl    String?
  bio         String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  journal     Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
}

model Volume {
  id          String   @id @default(cuid())
  journalId   String
  number      Int
  year        Int
  title       String?
  description String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  issues      Issue[]
  journal     Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, number, year])
  @@index([journalId])
}

model Issue {
  id          String    @id @default(cuid())
  journalId   String
  volumeId    String
  number      Int
  title       String?
  description String?
  coverImage  String?
  publishedAt DateTime?
  isCurrent   Boolean   @default(false)
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
  journal     Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  volume      Volume    @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  @@unique([volumeId, number])
  @@index([journalId])
  @@index([volumeId])
}

model Submission {
  id                    String                 @id @default(cuid())
  journalId             String
  authorId              String
  title                 String
  abstract              String
  manuscriptType        String?
  status                SubmissionStatus       @default(DRAFT)
  coverLetter           String?
  submittedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  currentReviewRound    Int                    @default(1)
  article               Article?
  decisions             EditorialDecision[]
  productionAssignments ProductionAssignment[]
  productionFiles       ProductionFile[]
  productionNotes       ProductionNote[]
  reviewAssignments     ReviewAssignment[]
  submissionAuthors     SubmissionAuthor[]
  author                User                   @relation("AuthorSubmissions", fields: [authorId], references: [id], onDelete: Cascade)
  journal               Journal                @relation(fields: [journalId], references: [id], onDelete: Cascade)
  files                 SubmissionFile[]
  keywords              SubmissionKeyword[]
  versions              SubmissionVersion[]

  @@index([journalId])
  @@index([authorId])
  @@index([status])
}

model SubmissionAuthor {
  id              String   @id @default(cuid())
  submissionId    String
  fullName        String
  email           String?
  affiliation     String?
  department      String?
  country         String?
  orcid           String?
  isCorresponding Boolean  @default(false)
  sortOrder       Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([submissionId, sortOrder])
}

model SubmissionFile {
  id           String     @id @default(cuid())
  submissionId String
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int?
  label        String?
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model SubmissionVersion {
  id                 String             @id @default(cuid())
  submissionId       String
  uploadedById       String
  versionNumber      Int
  manuscriptFileUrl  String
  manuscriptFileName String?
  responseFileUrl    String?
  responseFileName   String?
  coverLetter        String?
  authorNotes        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  reviewAssignments  ReviewAssignment[]
  submission         Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploadedBy         User               @relation("SubmissionVersionUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@unique([submissionId, versionNumber])
  @@index([submissionId])
  @@index([uploadedById])
}

model Keyword {
  id          String              @id @default(cuid())
  name        String              @unique
  createdAt   DateTime            @default(now())
  articles    ArticleKeyword[]
  submissions SubmissionKeyword[]
}

model SubmissionKeyword {
  submissionId String
  keywordId    String
  keyword      Keyword    @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@id([submissionId, keywordId])
}

model Category {
  id        String    @id @default(cuid())
  journalId String
  name      String
  slug      String
  createdAt DateTime  @default(now())
  articles  Article[]
  journal   Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, slug])
  @@index([journalId])
}

model ReviewAssignment {
  id                  String             @id @default(cuid())
  submissionId        String
  reviewerId          String
  status              ReviewStatus       @default(INVITED)
  invitedAt           DateTime           @default(now())
  acceptedAt          DateTime?
  dueDate             DateTime?
  completedAt         DateTime?
  blindType           String             @default("DOUBLE_BLIND")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  reviewRound         Int                @default(1)
  submissionVersionId String?
  review              Review?
  reviewer            User               @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  submission          Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionVersion   SubmissionVersion? @relation(fields: [submissionVersionId], references: [id])

  @@unique([submissionId, reviewerId, reviewRound])
  @@index([reviewerId])
  @@index([submissionId])
  @@index([submissionVersionId])
  @@index([reviewRound])
  @@index([status])
}

model Review {
  id           String           @id @default(cuid())
  assignmentId String           @unique
  assignment   ReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  score            Int?
  recommendation   ReviewRecommendation
  commentsToAuthor String?
  commentsToEditor String?
  submittedAt      DateTime             @default(now())

  attachments ReviewAttachment[]
}

model ReviewAttachment {
  id          String   @id @default(cuid())
  reviewId    String
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  mimeType    String?
  fileSize    Int?
  description String?
  uploadedAt  DateTime @default(now())

  @@index([reviewId])
}

model EditorialDecision {
  id               String           @id @default(cuid())
  submissionId     String
  editorId         String
  decision         SubmissionStatus
  comments         String?
  createdAt        DateTime         @default(now())
  revisionDeadline DateTime?
  editor           User             @relation(fields: [editorId], references: [id], onDelete: Cascade)
  submission       Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([editorId])
}

model Article {
  id           String             @id @default(cuid())
  journalId    String
  issueId      String?
  categoryId   String?
  submissionId String?            @unique
  title        String
  slug         String
  abstract     String
  body         String?
  pdfUrl       String?
  doi          String?
  status       ArticleStatus      @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  category     Category?          @relation(fields: [categoryId], references: [id])
  issue        Issue?             @relation(fields: [issueId], references: [id])
  journal      Journal            @relation(fields: [journalId], references: [id], onDelete: Cascade)
  submission   Submission?        @relation(fields: [submissionId], references: [id])
  authors      ArticleAuthor[]
  keywords     ArticleKeyword[]
  references   ArticleReference[]
  doiRecord    DoiRecord?

  @@unique([journalId, slug])
  @@index([journalId])
  @@index([issueId])
  @@index([status])
}

model ReviewerApplication {
  id                      String                    @id @default(cuid())
  journalId               String
  userId                  String?
  fullName                String
  email                   String
  phone                   String?
  affiliation             String
  department              String?
  country                 String
  currentPosition         String
  highestQualification    String
  primaryField            String
  secondaryFields         String?
  areasOfExpertise        String
  researchInterests       String?
  orcid                   String?
  googleScholarUrl        String?
  researchGateUrl         String?
  scopusId                String?
  webOfScienceId          String?
  profileUrl              String?
  yearsResearchExperience Int
  yearsReviewExperience   Int?
  publicationCount        Int?
  journalsReviewedFor     String?
  preferredTopics         String?
  availability            String?
  professionalStatement   String
  cvUrl                   String?
  recentPublicationUrl    String?
  conflictDeclaration     Boolean
  ethicsAgreement         Boolean
  dataConsent             Boolean
  status                  ReviewerApplicationStatus @default(PENDING)
  reviewNotes             String?
  reviewedById            String?
  reviewedAt              DateTime?
  submittedAt             DateTime                  @default(now())
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  journal                 Journal                   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  reviewedBy              User?                     @relation("ReviewerApplicationReviewer", fields: [reviewedById], references: [id])
  applicant               User?                     @relation("ReviewerApplicationApplicant", fields: [userId], references: [id])

  @@unique([journalId, email])
  @@index([journalId])
  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([reviewedById])
}

model ArticleAuthor {
  id          String  @id @default(cuid())
  articleId   String
  fullName    String
  email       String?
  affiliation String?
  country     String?
  orcid       String?
  sortOrder   Int     @default(0)
  article     Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model ArticleKeyword {
  articleId String
  keywordId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([articleId, keywordId])
}

model ArticleReference {
  id        String  @id @default(cuid())
  articleId String
  citation  String
  doi       String?
  url       String?
  sortOrder Int     @default(0)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model DoiRecord {
  id           String    @id @default(cuid())
  articleId    String?   @unique
  doi          String    @unique
  status       DOIStatus @default(PENDING)
  registeredAt DateTime?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  article      Article?  @relation(fields: [articleId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
}

model ActivityLog {
  id        String       @id @default(cuid())
  userId    String?
  action    ActivityType
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([action])
}

model ProductionAssignment {
  id           String           @id @default(cuid())
  submissionId String
  assigneeId   String
  assignedById String
  stage        ProductionStage
  status       ProductionStatus @default(PENDING)
  round        Int              @default(1)
  instructions String?
  dueDate      DateTime?
  startedAt    DateTime?
  submittedAt  DateTime?
  approvedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignedBy   User             @relation("ProductionAssignedBy", fields: [assignedById], references: [id])
  assignee     User             @relation("ProductionAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  files        ProductionFile[]
  notes        ProductionNote[]

  @@unique([submissionId, stage, round])
  @@index([submissionId])
  @@index([assigneeId])
  @@index([assignedById])
  @@index([stage])
  @@index([status])
}

model ProductionFile {
  id                     String                @id @default(cuid())
  submissionId           String
  productionAssignmentId String?
  uploadedById           String
  fileType               ProductionFileType
  fileName               String
  fileUrl                String
  mimeType               String?
  fileSize               Int?
  versionNumber          Int                   @default(1)
  description            String?
  isFinal                Boolean               @default(false)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  productionAssignment   ProductionAssignment? @relation(fields: [productionAssignmentId], references: [id])
  submission             Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploadedBy             User                  @relation("ProductionFileUploader", fields: [uploadedById], references: [id])

  @@index([submissionId])
  @@index([productionAssignmentId])
  @@index([uploadedById])
  @@index([fileType])
  @@index([isFinal])
}

model ProductionNote {
  id                     String                @id @default(cuid())
  submissionId           String
  productionAssignmentId String?
  authorId               String
  message                String
  isInternal             Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  author                 User                  @relation("ProductionNoteAuthor", fields: [authorId], references: [id])
  productionAssignment   ProductionAssignment? @relation(fields: [productionAssignmentId], references: [id], onDelete: Cascade)
  submission             Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([productionAssignmentId])
  @@index([authorId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CareerApplication {
  id                    String                  @id @default(cuid())
  journalId             String
  userId                String?
  position              CareerPosition
  fullName              String
  email                 String
  phone                 String?
  country               String
  affiliation           String?
  department            String?
  currentPosition       String?
  highestQualification  String
  fieldOfStudy          String?
  yearsExperience       Int
  publicationCount      Int?
  areasOfExpertise      String?
  professionalSkills    String?
  orcid                 String?
  googleScholarUrl      String?
  researchGateUrl       String?
  linkedinUrl           String?
  scopusId              String?
  webOfScienceId        String?
  cvUrl                 String?
  coverLetterUrl        String?
  certificatesUrl       String?
  portfolioUrl          String?
  professionalStatement String
  availability          String?
  salaryExpectation     String?
  consentAccepted       Boolean                 @default(false)
  declarationAccepted   Boolean                 @default(false)
  status                CareerApplicationStatus @default(PENDING)
  reviewNotes           String?
  interviewDate         DateTime?
  reviewedById          String?
  reviewedAt            DateTime?
  submittedAt           DateTime                @default(now())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  journal               Journal                 @relation(fields: [journalId], references: [id], onDelete: Cascade)
  reviewedBy            User?                   @relation("CareerApplicationReviewer", fields: [reviewedById], references: [id])
  applicant             User?                   @relation("CareerApplicationApplicant", fields: [userId], references: [id])

  @@index([journalId])
  @@index([userId])
  @@index([email])
  @@index([position])
  @@index([status])
  @@index([reviewedById])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR_IN_CHIEF
  MANAGING_EDITOR
  SECTION_EDITOR
  REVIEWER
  AUTHOR
  READER
  COPYEDITOR
  TYPESETTER
  PROOFREADER
  PUBLISHER
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_INITIAL_REVIEW
  UNDER_PEER_REVIEW
  REVISION_REQUIRED
  ACCEPTED
  REJECTED
  PUBLISHED
  WITHDRAWN
  COPYEDITING
  TYPESETTING
  PROOFREADING
  AUTHOR_PROOF_APPROVAL
  READY_FOR_PUBLICATION
}

enum ReviewRecommendation {
  ACCEPT
  MINOR_REVISION
  MAJOR_REVISION
  REJECT
}

enum ReviewStatus {
  INVITED
  ACCEPTED
  DECLINED
  SUBMITTED
  CANCELLED
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum DOIStatus {
  PENDING
  REGISTERED
  FAILED
}

enum NotificationType {
  GENERAL
  SUBMISSION
  REVIEW
  DECISION
  PUBLICATION
  PAYMENT
  SYSTEM
}

enum ActivityType {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  SUBMIT_MANUSCRIPT
  ASSIGN_REVIEWER
  SUBMIT_REVIEW
  MAKE_DECISION
  PUBLISH_ARTICLE
  REGISTER_DOI
}

enum ProductionStage {
  COPYEDITING
  TYPESETTING
  PROOFREADING
  FINAL_APPROVAL
}

enum ProductionStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  CANCELLED
}

enum ProductionFileType {
  SOURCE_MANUSCRIPT
  COPYEDITED_MANUSCRIPT
  TYPESET_DOCUMENT
  PDF_GALLEY
  HTML_GALLEY
  XML_GALLEY
  PROOF_FILE
  FINAL_PUBLICATION_FILE
  SUPPLEMENTARY_FILE
}

enum ReviewerApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CareerApplicationStatus {
  PENDING
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CareerPosition {
  EDITOR_IN_CHIEF
  MANAGING_EDITOR
  SECTION_EDITOR
  REVIEWER
  COPYEDITOR
  PROOFREADER
  TYPESETTER
  EDITORIAL_ASSISTANT
}
