}

/**
 * The in-app copyright / publication agreement an author (or every
 * co-author, depending on JournalSettings.agreementSignatureMode)
 * must e-sign before a manuscript can be published. One per
 * submission.
 */
model PublicationAgreement {
  id              String                 @id @default(cuid())
  submissionId    String                 @unique
  licenseType     LicenseType
  signatureMode   AgreementSignatureMode
  templateVersion String
  /*
   * A snapshot of the full agreement text shown to signers, so a
   * later edit to the template never changes what an already-sent
   * or already-signed agreement legally says.
   */
  agreementText String
  status        AgreementStatus @default(DRAFT)
  pdfFileUrl    String?
  pdfSha256     String?
  sentAt        DateTime?
  signedAt      DateTime?
  declinedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  submission Submission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  signatures AgreementSignature[]

  @@index([status])
}

/**
 * One row per person required to sign. If `userId` is set, the
 * signer is the logged-in corresponding author; if
 * `submissionAuthorId` is set instead, the signer is a co-author
 * with no account, who signs via an emailed tokenized link.
 */
model AgreementSignature {
  id                 String    @id @default(cuid())
  agreementId        String
  submissionAuthorId String?
  userId             String?
  signerName         String
  signerEmail        String
  tokenHash          String?   @unique
  tokenExpiresAt     DateTime?
  typedLegalName     String?
  ipAddress          String?
  userAgent          String?
  signedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  agreement        PublicationAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  submissionAuthor  SubmissionAuthor?   @relation(fields: [submissionAuthorId], references: [id], onDelete: SetNull)
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([agreementId])
  @@index([submissionAuthorId])
  @@index([userId])
}
